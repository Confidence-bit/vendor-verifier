{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vendor Claims",
  "type": "object",
  "required": ["schema_version", "vendor", "signed_at", "claims"],
  "properties": {
    "schema_version": { "type": "string" },
    "vendor": { "type": "string" },
    "signed_at": { "type": "string", "format": "date-time" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "control",
          "operator",
          "value",
          "evidence_supplied"
        ],
        "properties": {
          "claim_id": { "type": "string" },
          "control": { "type": "string" },
          "operator": { "type": "string" },
          "value": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" }
            ]
          },
          "evidence_supplied": { "type": "boolean" }
        }
      }
    }
  }
}
