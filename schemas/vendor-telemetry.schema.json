{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vendor Telemetry",
  "type": "object",
  "required": [
    "schema_version",
    "exported_at",
    "tls",
    "privileged_access",
    "deletion_jobs",
    "subprocessors"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "tls": {
      "type": "object"
    },
    "privileged_access": {
      "type": "array"
    },
    "deletion_jobs": {
      "type": "array"
    },
    "subprocessors": {
      "type": "array"
    }
  }
}
